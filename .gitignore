# No trailing slash: that form matches directories only, so a node_modules
# symlink (the usual way to borrow deps into a worktree) slipped past it and
# got committed, which broke the Vercel build on `pnpm install`.
node_modules
.claude/
.DS_Store
scraper/pages/
scraper/urls.json
scraper/data.json
scraper/sample_data.json
scraper/.progress.json
dpreview-audit-report.json
__pycache__/
*.pyc
.next/
/docs/plans/
.vercel
.worktrees/
.env*
!.env.example

