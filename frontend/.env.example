# Transaction pooler (pgbouncer, port 6543) of the self-hosted database; see ../infra/db/README.md
DATABASE_URL="postgresql://lensdb:PASSWORD@HOST:6543/lensdb?sslmode=verify-full"

# Secret salt for hashing IP addresses (used for per-IP rate limiting on ratings)
# Generate with: openssl rand -hex 32
RATE_HASH_SALT=""

# Upstash Redis (for rate limiting across serverless instances)
# Create a free database at https://console.upstash.com or via Vercel integration
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Secret for signing session tokens (REQUIRED - app will not start without it)
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Resend (email service for verification emails)
# Create account at https://resend.com and verify your domain
RESEND_API_KEY=""
RESEND_FROM_EMAIL="The Lens DB <noreply@thelensdb.com>"
RESEND_REPLY_TO=""    # Optional: inbox that replies to transactional mail should reach

# Base URL for email links (verification, etc.)
APP_URL="https://thelensdb.com"

AI_GATEWAY_API_KEY=        # Vercel AI Gateway API key (required for /chat, price classification, DPReview dedupe/audit)
LISTING_CLASSIFIER_MODEL=""  # Optional: override the eBay listing classifier model (default google/gemini-3.1-flash-lite)

# Secret protecting /api/cron/* endpoints (sent as Bearer token by Vercel Cron and the GitHub Actions scraper workflows/CLIs)
# Required — cron requests are rejected (401) when unset
CRON_SECRET=""

# eBay API credentials (Browse API listing search + affiliate links)
EBAY_APP_ID=""
EBAY_CERT_ID=""
EBAY_CAMPAIGN_ID=""

# parse.bot key for the KEH catalogue mirror (/api/cron/keh-catalogue)
PARSE_API_KEY=""

# "true" opens the public read API (/api/v1), /api/mcp and /developers
PUBLIC_API_ENABLED=""

# "false" switches the chat off entirely: /api/chat and /chat answer 404 and the nav and footer hide it
CHAT_ENABLED=""

# Cloudflare R2 (image uploads via admin portal)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
