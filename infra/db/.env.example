# Copy to .env next to docker-compose.yml. Never commit .env.

# Superuser. Only usable from inside the container (docker compose exec
# postgres psql); pg_hba.conf rejects it over the network.
POSTGRES_PASSWORD=

# Application role, owner of the lensdb database. Letters and digits only,
# 32+ characters: openssl rand -hex 24
LENSDB_PASSWORD=

# Host ports (the only two to open to the outside).
DB_PORT=5432
POOLER_PORT=6543

# Pooler sizing. default_pool_size is server connections per database/user
# pair; 20 is plenty for a Vercel app whose per-instance pool is 4.
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=20

# Nightly on-box dump.
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=03
BACKUP_ON_START=0

# Only with `docker compose --profile ddns up -d`, for a dynamic public IP.
VERCEL_TOKEN=
VERCEL_TEAM_ID=            # from `vercel teams ls`, only if the domain is under a team
VERCEL_DNS_RECORD_ID=
DDNS_HOSTNAME=db.thelensdb.com
DDNS_INTERVAL=300
